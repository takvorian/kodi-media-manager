<?xml version="1.0" encoding="utf-8"?>
<Settings xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="1">
  <CleanDotFanartJPG>false</CleanDotFanartJPG>
  <EmberModules>
    <Module>
      <AssemblyName>scraper.TMDB.Data.dll</AssemblyName>
    </Module>
  </EmberModules>
  <FileSystemValidExts>
    <string>.mkv</string>
    <string>.mp4</string>
    <string>.avi</string>
  </FileSystemValidExts>
  <FileSystemValidSubtitlesExts>
    <string>.srt</string>
    <string>.sub</string>
  </FileSystemValidSubtitlesExts>
  <GeneralLanguage>de-DE</GeneralLanguage>
  <ProxyCredentials>
    <UserName>proxyuser</UserName>
    <Password>secret</Password>
    <Domain />
  </ProxyCredentials>
  <ProxyPort>3128</ProxyPort>
  <ProxyURI>http://proxy.local</ProxyURI>
</Settings>

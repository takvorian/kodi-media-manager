<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.tiktak.kmm</groupId>
        <artifactId>kmm-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>kmm-app</artifactId>
    <name>KMM App</name>
    <description>Spring-Boot-Anwendung: REST-API, Plugin-Verwaltung, Persistenz und Auslieferung der UI.</description>

    <properties>
        <test-plugins.directory>${project.build.directory}/test-plugins</test-plugins.directory>
        <test-plugin.artifactId>kmm-plugin-testdata</test-plugin.artifactId>
        <bundled-plugins.artifactIds>kmm-plugin-tmdb,kmm-plugin-fanarttv,kmm-plugin-tvdb,kmm-plugin-televisiontunes,kmm-plugin-youtube,kmm-plugin-trakt,kmm-plugin-omdb,kmm-plugin-moviepilot,kmm-plugin-ofdb</bundled-plugins.artifactIds>
        <bundled-plugins.directory>${project.build.outputDirectory}/bundled-plugins</bundled-plugins.directory>
    </properties>

    <dependencies>
        <!-- KMM -->
        <dependency>
            <groupId>de.tiktak.kmm</groupId>
            <artifactId>kmm-plugin-api</artifactId>
        </dependency>
        <dependency>
            <groupId>de.tiktak.kmm</groupId>
            <artifactId>kmm-scanner</artifactId>
        </dependency>
        <dependency>
            <groupId>de.tiktak.kmm</groupId>
            <artifactId>kmm-nfo</artifactId>
        </dependency>
        <dependency>
            <groupId>de.tiktak.kmm</groupId>
            <artifactId>kmm-migration-ember</artifactId>
        </dependency>
        <dependency>
            <groupId>de.tiktak.kmm</groupId>
            <artifactId>kmm-kodi</artifactId>
        </dependency>
        <dependency>
            <groupId>de.tiktak.kmm</groupId>
            <artifactId>kmm-media</artifactId>
        </dependency>
        <dependency>
            <groupId>de.tiktak.kmm</groupId>
            <artifactId>kmm-migration-ember</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>de.tiktak.kmm</groupId>
            <artifactId>kmm-kodi</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>de.tiktak.kmm</groupId>
            <artifactId>kmm-ui</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Spring -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <!-- Plugins -->
        <dependency>
            <groupId>org.pf4j</groupId>
            <artifactId>pf4j</artifactId>
        </dependency>

        <!-- Datenbanken: H2 (standalone), MariaDB (Docker), PostgreSQL (optional) -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.mariadb.jdbc</groupId>
            <artifactId>mariadb-java-client</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-mariadb</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Das Test-Plugin wird nur in target/test-plugins kopiert und dort von PF4J geladen. Auf dem
            Test-Classpath darf es nicht liegen, sonst fände PF4J die Extension doppelt.
        -->
        <dependency>
            <groupId>de.tiktak.kmm</groupId>
            <artifactId>kmm-plugin-testdata</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Mitgelieferte Plugins: werden als Datei unter bundled-plugins/ ins JAR gelegt und beim Start
            ins Plugin-Verzeichnis installiert. Der Scope test sorgt nur für die Build-Reihenfolge.
        -->
        <dependency>
            <groupId>de.tiktak.kmm</groupId>
            <artifactId>kmm-plugin-tmdb</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>de.tiktak.kmm</groupId>
            <artifactId>kmm-plugin-fanarttv</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>de.tiktak.kmm</groupId>
            <artifactId>kmm-plugin-tvdb</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>de.tiktak.kmm</groupId>
            <artifactId>kmm-plugin-televisiontunes</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>de.tiktak.kmm</groupId>
            <artifactId>kmm-plugin-youtube</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>de.tiktak.kmm</groupId>
            <artifactId>kmm-plugin-trakt</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>de.tiktak.kmm</groupId>
            <artifactId>kmm-plugin-omdb</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>de.tiktak.kmm</groupId>
            <artifactId>kmm-plugin-moviepilot</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>de.tiktak.kmm</groupId>
            <artifactId>kmm-plugin-ofdb</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>kmm-app</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-bundled-plugins</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeArtifactIds>${bundled-plugins.artifactIds}</includeArtifactIds>
                            <outputDirectory>${bundled-plugins.directory}</outputDirectory>
                            <stripVersion>true</stripVersion>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-test-plugins</id>
                        <phase>process-test-resources</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeArtifactIds>${test-plugin.artifactId},${bundled-plugins.artifactIds}</includeArtifactIds>
                            <outputDirectory>${test-plugins.directory}</outputDirectory>
                            <stripVersion>true</stripVersion>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <classpathDependencyExcludes>
                        <classpathDependencyExclude>de.tiktak.kmm:${test-plugin.artifactId}</classpathDependencyExclude>
                        <classpathDependencyExclude>de.tiktak.kmm:kmm-plugin-tmdb</classpathDependencyExclude>
                        <classpathDependencyExclude>de.tiktak.kmm:kmm-plugin-fanarttv</classpathDependencyExclude>
                        <classpathDependencyExclude>de.tiktak.kmm:kmm-plugin-tvdb</classpathDependencyExclude>
                        <classpathDependencyExclude>de.tiktak.kmm:kmm-plugin-televisiontunes</classpathDependencyExclude>
                        <classpathDependencyExclude>de.tiktak.kmm:kmm-plugin-youtube</classpathDependencyExclude>
                        <classpathDependencyExclude>de.tiktak.kmm:kmm-plugin-trakt</classpathDependencyExclude>
                        <classpathDependencyExclude>de.tiktak.kmm:kmm-plugin-omdb</classpathDependencyExclude>
                        <classpathDependencyExclude>de.tiktak.kmm:kmm-plugin-moviepilot</classpathDependencyExclude>
                        <classpathDependencyExclude>de.tiktak.kmm:kmm-plugin-ofdb</classpathDependencyExclude>
                    </classpathDependencyExcludes>
                    <systemPropertyVariables>
                        <kmm.test-plugins.directory>${test-plugins.directory}</kmm.test-plugins.directory>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Windows-Installer: ./mvnw -Pinstaller -DskipTests package legt die MSI unter kmm-app/target/installer ab.
            jpackage braucht WiX 3 auf dem PATH. Die Upgrade-ID darf sich nie ändern, sonst ersetzt eine neue
            Version die alte nicht.
        -->
        <profile>
            <id>installer</id>
            <properties>
                <installer.name>Kodi Media Manager</installer.name>
                <installer.upgrade-uuid>6cff534d-eb86-5f8d-b555-4ad792b82bec</installer.upgrade-uuid>
                <installer.input>${project.build.directory}/installer-input</installer.input>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>parse-installer-version</id>
                                <goals>
                                    <goal>parse-version</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>copy-installer-input</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${installer.input}</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.build.directory}</directory>
                                            <includes>
                                                <include>${project.build.finalName}.jar</include>
                                            </includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>jpackage</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/jpackage</executable>
                                    <arguments>
                                        <argument>--type</argument>
                                        <argument>msi</argument>
                                        <argument>--name</argument>
                                        <argument>${installer.name}</argument>
                                        <argument>--app-version</argument>
                                        <argument>${parsedVersion.majorVersion}.${parsedVersion.minorVersion}.${parsedVersion.incrementalVersion}</argument>
                                        <argument>--vendor</argument>
                                        <argument>tiktak</argument>
                                        <argument>--description</argument>
                                        <argument>Medienverwaltung für Kodi</argument>
                                        <argument>--about-url</argument>
                                        <argument>https://github.com/takvorian/kodi-media-manager</argument>
                                        <argument>--license-file</argument>
                                        <argument>${maven.multiModuleProjectDirectory}/LICENSE</argument>
                                        <argument>--icon</argument>
                                        <argument>${maven.multiModuleProjectDirectory}/kmm-ui/public/favicon.ico</argument>
                                        <argument>--input</argument>
                                        <argument>${installer.input}</argument>
                                        <argument>--main-jar</argument>
                                        <argument>${project.build.finalName}.jar</argument>
                                        <argument>--dest</argument>
                                        <argument>${project.build.directory}/installer</argument>
                                        <argument>--win-console</argument>
                                        <argument>--win-per-user-install</argument>
                                        <argument>--win-dir-chooser</argument>
                                        <argument>--win-menu</argument>
                                        <argument>--win-menu-group</argument>
                                        <argument>Kodi Media Manager</argument>
                                        <argument>--win-shortcut</argument>
                                        <argument>--win-upgrade-uuid</argument>
                                        <argument>${installer.upgrade-uuid}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>

# Copy to docker/.env and adjust the values.

# Datenbank
KMM_DB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me-too

# Login to the web interface
KMM_ADMIN_USER=admin
KMM_ADMIN_PASSWORD=change-me

# API keys: taken over on the first start as long as the settings page has none yet;
# after that the key saved there applies.
# TMDB-API-Key (v3) oder Lese-Token (v4), siehe https://www.themoviedb.org/settings/api
KMM_TMDB_API_KEY=

# fanart.tv-API-Key, siehe https://fanart.tv/get-an-api-key/
KMM_FANARTTV_API_KEY=

# TVDB-API-Key (v4), siehe https://thetvdb.com/api-information
KMM_TVDB_API_KEY=

# Optional - otherwise maintain them on the settings page. Values set here lock the setting there.
# KMM_TMDB_LANGUAGE=de-DE
# KMM_ARTWORK_LANGUAGE=de
# KMM_PROXY_HOST=proxy.local
# KMM_PROXY_PORT=8080
# KMM_PROXY_USERNAME=
# KMM_PROXY_PASSWORD=

# Version of the image on Docker Hub, e.g. 0.1; the latest if not set
# KMM_IMAGE_TAG=latest

# Host port of the web interface
KMM_PORT=8080

# User/group KMM uses to access the media
PUID=1000
PGID=1000
TZ=Europe/Berlin

# Verzeichnisse auf dem Host
KMM_CONFIG_DIR=./data/config
KMM_MEDIA_DIR=./data/media

# Kopieren nach docker/.env und Werte anpassen.

# Datenbank
KMM_DB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me-too

# Anmeldung an der Weboberfläche
KMM_ADMIN_USER=admin
KMM_ADMIN_PASSWORD=change-me

# API-Keys: werden beim ersten Start übernommen, solange auf der Einstellungsseite noch keiner steht;
# danach gilt der dort gespeicherte Key.
# TMDB-API-Key (v3) oder Lese-Token (v4), siehe https://www.themoviedb.org/settings/api
KMM_TMDB_API_KEY=

# fanart.tv-API-Key, siehe https://fanart.tv/get-an-api-key/
KMM_FANARTTV_API_KEY=

# TVDB-API-Key (v4), siehe https://thetvdb.com/api-information
KMM_TVDB_API_KEY=

# Optional – sonst auf der Einstellungsseite pflegen. Gesetzte Werte sperren die Einstellung dort.
# KMM_TMDB_LANGUAGE=de-DE
# KMM_ARTWORK_LANGUAGE=de
# KMM_PROXY_HOST=proxy.local
# KMM_PROXY_PORT=8080
# KMM_PROXY_USERNAME=
# KMM_PROXY_PASSWORD=

# Version des Images auf Docker Hub, z. B. 0.1; ohne Angabe die neueste
# KMM_IMAGE_TAG=latest

# Host-Port der Weboberfläche
KMM_PORT=8080

# Benutzer/Gruppe, mit denen KMM auf die Medien zugreift
PUID=1000
PGID=1000
TZ=Europe/Berlin

# Verzeichnisse auf dem Host
KMM_CONFIG_DIR=./data/config
KMM_MEDIA_DIR=./data/media
